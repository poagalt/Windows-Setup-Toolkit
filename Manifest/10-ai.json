                           "items":  [
                                         {
                                             "id":  "copilot-app",
                                             "settingsPath": "Undo the run, then reinstall Copilot from the Microsoft Store if it does not come back on its own.",
                                             "symptoms": ["copilot missing", "copilot gone", "no copilot", "copilot not working", "copilot uninstalled", "win+c not working", "copilot button missing", "copilot taskbar gone", "cannot find copilot", "copilot removed", "ai assistant missing"],
                                             "bloat": 3,
                                             "name":  "Copilot app and taskbar entry",
                                             "desc":  "The Copilot app, its taskbar button, and Win+C. Windows' own Copilot policy is set too, but it is deprecated and now only stops the app being installed again during an upgrade.",
                                             "risk":  0,
                                             "default":  true,
                                             "order":  20,
                                             "actions":  [
                                                             {
                                                                 "type":  "appx",
                                                                 "names":  [
                                                                               "Microsoft.Copilot",
                                                                               "Microsoft.Copilot.*",
                                                                               "Microsoft.Windows.Ai.Copilot.Provider",
                                                                               "MicrosoftWindows.Client.CoPilot",
                                                                               "Microsoft.Windows.Copilot*"
                                                                           ]
                                                             },
                                                             {
                                                                 "type":  "appxPolicy",
                                                                 "guards":  [
                                                                                "edition:enterprise",
                                                                                "build:>=26100"
                                                                            ],
                                                                 "packages":  [
                                                                                  "Microsoft.Copilot_8wekyb3d8bbwe"
                                                                              ]
                                                             },
                                                             {
                                                                 "type":  "registry",
                                                                 "scope":  "allusers",
                                                                 "values":  [
                                                                                {
                                                                                    "path":  "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
                                                                                    "name":  "ShowCopilotButton",
                                                                                    "kind":  "DWord",
                                                                                    "value":  0
                                                                                },
                                                                                {
                                                                                    "path":  "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsCopilot",
                                                                                    "name":  "TurnOffWindowsCopilot",
                                                                                    "kind":  "DWord",
                                                                                    "value":  1
                                                                                }
                                                                            ]
                                                             }
                                                         ],
                                             "tier":  1
                                         },
                                         {
                                             "id":  "copilot-key",
                                             "settingsPath": "PowerToys > Keyboard Manager > Remap a shortcut, and delete the Win+Shift+F23 remap; on builds with the native setting, Settings > Personalization > Text input > Customize Copilot key. Or undo the run.",
                                             "symptoms": ["copilot key not working", "copilot key does nothing", "keyboard copilot button", "right ctrl instead of copilot", "wrong key behavior"],
                                             "bloat": 3,
                                             "name":  "Copilot key acts as Right Ctrl",
                                             "desc":  "Uses the native setting where the build has it, otherwise a PowerToys remap for Win+Shift+F23 - which needs PowerToys installed (tick it under Add) and does not reach windows running as administrator.",
                                             "risk":  0,
                                             "default":  true,
                                             "order":  96,
                                             "actions":  [
                                                             {
                                                                 "type":  "script",
                                                                 "handler":  "CopilotKeyToRightCtrl"
                                                             }
                                                         ],
                                             "tier":  1
                                         },
                                         {
                                             "id":  "recall",
