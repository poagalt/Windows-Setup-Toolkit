                                         },
                                         {
                                             "id":  "gamebar",
                                             "settingsPath": "Undo the run. Reinstalling Xbox Game Bar from the Microsoft Store on its own is not enough - the ms-gamebar, ms-gamebarservices, and ms-gamingoverlay stubs under Software\\Classes have to go with it.",
                                             "symptoms": ["game bar not working", "win+g not working", "no game bar", "game overlay missing", "game bar missing", "cannot record game", "game bar will not open", "overlay not showing", "fps counter missing", "you'll need a new app to open ms-gamebar", "need a new app to open this link", "ms-gamebar popup", "ms-gamingoverlay popup", "popup when i connect a controller"],
