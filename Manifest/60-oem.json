                                         {
                                             "id":  "wpbt",
                                             "settingsPath": "Undo the run.",
                                             "symptoms": ["vendor app not reinstalling", "manufacturer software missing after reinstall"],
                                             "bloat": 3,
                                             "name":  "Block firmware-injected vendor software (WPBT)",
                                             "desc":  "The Windows Platform Binary Table lets the motherboard firmware drop an executable into Windows and run it at every boot, which is how some vendor software survives a clean install. This switches it off.",
                                             "risk":  1,
                                             "default":  true,
                                             "order":  84,
                                             "reboot":  true,
                                             "actions":  [
                                                             {
                                                                 "type":  "registry",
                                                                 "scope":  "machine",
                                                                 "values":  [
                                                                                {
                                                                                    "path":  "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager",
                                                                                    "name":  "DisableWpbtExecution",
                                                                                    "kind":  "DWord",
                                                                                    "value":  1
                                                                                }
                                                                            ]
                                                             }
                                                         ],
                                             "tier":  3,
                                             "riskNote":  "WPBT is not only used for bloatware. Business laptops ship anti-theft and asset-tracking agents through it, and a few vendors deliver a genuinely required driver this way, so those stop arriving. Nothing already installed is removed - this only stops the firmware putting it back. Reverses cleanly, but needs a restart either way."
                                         },
                                         {
                                             "id":  "device-companion",
                                             "settingsPath": "Undo the run.",
                                             "symptoms": ["device app not installing", "no companion app prompt", "hardware app missing"],
                                             "bloat": 2,
                                             "name":  "Stop Windows fetching companion apps for your hardware",
                                             "desc":  "Turns off the device metadata download that installs a vendor's app when you plug something in. Drivers still install normally.",
                                             "risk":  0,
                                             "default":  true,
                                             "order":  85,
                                             "actions":  [
                                                             {
                                                                 "type":  "registry",
                                                                 "scope":  "machine",
                                                                 "values":  [
                                                                                {
                                                                                    "path":  "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Device Metadata",
                                                                                    "name":  "PreventDeviceMetadataFromNetwork",
                                                                                    "kind":  "DWord",
                                                                                    "value":  1
                                                                                },
                                                                                {
                                                                                    "path":  "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Device Metadata",
                                                                                    "name":  "PreventDeviceMetadataFromNetwork",
                                                                                    "kind":  "DWord",
                                                                                    "value":  1
                                                                                }
                                                                            ]
                                                             }
                                                         ],
                                             "tier":  2
                                         },
                                         {
                                             "id":  "driver-coinstallers",
                                             "settingsPath": "Undo the run.",
                                             "symptoms": ["driver control panel missing", "graphics control panel missing", "no vendor app after driver install", "audio control panel missing"],
                                             "bloat": 3,
                                             "name":  "Block software bundled inside driver packages",
                                             "desc":  "Driver packages are allowed to carry a co-installer that runs vendor software alongside the driver. This stops that half without touching the driver.",
                                             "risk":  1,
                                             "default":  true,
                                             "order":  85,
                                             "reboot":  true,
                                             "actions":  [
                                                             {
                                                                 "type":  "registry",
                                                                 "scope":  "machine",
                                                                 "values":  [
                                                                                {
                                                                                    "path":  "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Device Installer",
                                                                                    "name":  "DisableCoInstallers",
                                                                                    "kind":  "DWord",
                                                                                    "value":  1
                                                                                }
                                                                            ]
                                                             }
                                                         ],
                                             "tier":  3,
                                             "riskNote":  "A few devices use the co-installer to finish their own setup - some fingerprint readers, docking stations, and audio DSPs among them - and can end up half-configured after a driver update. The driver itself always still installs."
                                         }
