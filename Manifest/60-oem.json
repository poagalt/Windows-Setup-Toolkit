                                                                 "guards":  [
                                                                                "oem:razer"
                                                                            ],
                                                                 "names":  [
                                                                               "*RazerCortex*"
                                                                           ]
                                                             },
                                                             {
                                                                 "type":  "appx",
                                                                 "guards":  [
                                                                                "oem:msi"
                                                                            ],
                                                                 "names":  [
                                                                               "*MSIAppPlayer*",
                                                                               "*MSICenter*Promo*"
                                                                           ]
                                                             }
                                                         ],
                                             "tier":  1
                                         },
                                         {
                                             "id":  "oem-security",
                                             "settingsPath": "Reinstall it from your manufacturer support site.",
                                             "symptoms": ["vendor security app missing", "fingerprint software gone"],
                                             "bloat": 3,
                                             "name":  "Vendor security agents",
                                             "desc":  "HP Wolf Security with its Sure Click, Sure Sense, and Sure Run agents, and Dell Trusted Device.",
                                             "risk":  1,
                                             "default":  true,
                                             "order":  83,
                                             "actions":  [
                                                             {
                                                                 "type":  "uninstall",
                                                                 "guards":  [
                                                                                "oem:hp"
                                                                            ],
                                                                 "timeoutSeconds":  900,
                                                                 "match":  [
                                                                               "HP Wolf Security*",
                                                                               "HP Security Update Service*",
                                                                               "HP Sure Click*",
                                                                               "HP Sure Sense*",
                                                                               "HP Sure Run*",
                                                                               "HP Client Security Manager*"
                                                                           ]
                                                             },
                                                             {
                                                                 "type":  "uninstall",
                                                                 "guards":  [
                                                                                "oem:dell"
                                                                            ],
                                                                 "timeoutSeconds":  900,
                                                                 "match":  [
                                                                               "Dell Trusted Device*"
                                                                           ]
                                                             }
                                                         ],
                                             "tier":  3,
                                             "riskNote":  "Removes vendor endpoint security agents. HP Sure Sense is an antivirus, so Windows Security takes over from it. On a managed work machine your employer may require these - check first. Dell Encryption is deliberately left alone: uninstalling it without Dell's own removal agent leaves the data it encrypted unreadable."
                                         },
                                         {
                                             "id":  "oem-media",
                                             "settingsPath": "Reinstall it from the vendor, or use another media application.",
                                             "symptoms": ["media suite missing", "dvd player gone", "bundled media app missing"],
                                             "bloat": 3,
                                             "name":  "Bundled media suites",
                                             "desc":  "CyberLink's PowerDVD, PowerDirector, PhotoDirector, Power2Go, and MediaShow, plus Nero, Roxio, Corel trials, and WildTangent Games.",
                                             "risk":  1,
                                             "default":  true,
                                             "order":  84,
                                             "actions":  [
                                                             {
                                                                 "type":  "uninstall",
                                                                 "timeoutSeconds":  900,
                                                                 "match":  [
                                                                               "CyberLink*",
                                                                               "PowerDVD*",
                                                                               "PowerDirector*",
                                                                               "Power2Go*",
                                                                               "PhotoDirector*",
                                                                               "MediaShow*",
                                                                               "Nero*",
                                                                               "WildTangent*",
                                                                               "Corel*Trial*",
                                                                               "Roxio*"
                                                                           ]
                                                             },
                                                             {
                                                                 "type":  "appx",
                                                                 "names":  [
                                                                               "CyberLinkCorp.*",
                                                                               "*WildTangent*",
                                                                               "*PowerDirector*"
                                                                           ]
                                                             }
                                                         ],
                                             "tier":  1,
                                             "riskNote":  "These are matched by product name, so a copy you bought goes along with a bundled trial - PowerDVD is the usual way to play Blu-ray discs on Windows. Untick this if you paid for one of them."
                                         },
                                         {
                                             "id":  "oem-reg",
                                             "settingsPath": "Reinstall from your manufacturer support site.",
                                             "symptoms": ["registration app missing", "trial offer app gone"],
                                             "bloat": 2,
                                             "name":  "Registration and trial-offer apps",
                                             "desc":  "Product registration, warranty prompts, and bundled trial offers.",
                                             "risk":  0,
                                             "default":  true,
                                             "order":  84,
                                             "guards":  [
                                                            "!oem:generic"
                                                        ],
                                             "actions":  [
                                                             {
                                                                 "type":  "uninstall",
                                                                 "match":  [
                                                                               "*Product Registration*",
                                                                               "*Registration Service*",
                                                                               "*Trial*Offer*",
                                                                               "*Welcome*Center*",
                                                                               "*Getting Started*"
                                                                           ],
                                                                 "exclude":  [
                                                                                 "Microsoft*",
                                                                                 "*Visual C++*",
                                                                                 "*Runtime*"
                                                                             ]
                                                             }
                                                         ],
                                             "tier":  1
                                         },
                                         {
                                             "id":  "oem-shortcuts",
                                             "settingsPath": "Drag the shortcut back out of the Recycle Bin, or undo the run.",
                                             "symptoms": ["desktop shortcut removed", "affiliate icon gone"],
                                             "bloat": 2,
                                             "name":  "Affiliate desktop shortcuts and tiles",
                                             "desc":  "Booking.com, Amazon, and similar planted links across desktop and Start. A shortcut that opens a program you have installed is kept.",
                                             "risk":  0,
                                             "default":  true,
                                             "order":  85,
                                             "actions":  [
                                                             {
                                                                 "type":  "shortcut",
                                                                 "keepLive":  true,
                                                                 "names":  [
                                                                               "Booking.com*",
                                                                               "Amazon*",
                                                                               "eBay*",
                                                                               "Agoda*",
                                                                               "Get Office*",
                                                                               "Microsoft 365*",
                                                                               "Dropbox*",
                                                                               "Opera*",
                                                                               "TikTok*",
                                                                               "Instagram*",
                                                                               "*Free Trial*",
                                                                               "WildTangent*",
                                                                               "*Games*Center*"
                                                                           ]
                                                             }
                                                         ],
                                             "tier":  1
                                         },
                                         {
                                             "id":  "gpu-telemetry",
                                             "settingsPath": "Re-enable NVIDIA Telemetry Container in services.msc and its tasks in Task Scheduler, or undo the run. The Intel and AMD programs reinstall from the vendor.",
                                             "symptoms": ["nvidia telemetry off", "gpu telemetry"],
                                             "bloat": 1,
                                             "name":  "GPU telemetry",
                                             "desc":  "NVIDIA's telemetry service and tasks as older drivers install them, AMD's User Experience Program, and Intel's Computing Improvement Program. Drivers are untouched. NVIDIA App's own telemetry runs inside the display driver's container and is switched off in NVIDIA App's settings, not here.",
                                             "risk":  0,
                                             "default":  true,
                                             "order":  86,
                                             "actions":  [
                                                             {
                                                                 "type":  "task",
                                                                 "guards":  [
                                                                                "gpu:nvidia"
                                                                            ],
                                                                 "tasks":  [
                                                                               "\\NvTmRep*",
                                                                               "\\NvTmMon*",
                                                                               "\\NvTmDataSet*",
                                                                               "\\NVIDIA*Telemetry*"
                                                                           ]
                                                             },
                                                             {
                                                                 "type":  "service",
                                                                 "guards":  [
                                                                                "gpu:nvidia"
                                                                            ],
                                                                 "startupType":  "Disabled",
                                                                 "names":  [
                                                                               "NvTelemetryContainer"
                                                                           ]
                                                             },
                                                             {
                                                                 "type":  "uninstall",
                                                                 "guards":  [
                                                                                "gpu:amd"
                                                                            ],
                                                                 "match":  [
                                                                               "AMD User Experience Program*"
                                                                           ]
                                                             },
                                                             {
                                                                 "type":  "uninstall",
                                                                 "match":  [
                                                                               "Intel*Computing Improvement Program*"
                                                                           ]
                                                             }
                                                         ],
                                             "tier":  1
                                         },
                                         {
                                             "id":  "wpbt",
                                             "settingsPath": "Undo the run.",
                                             "symptoms": ["vendor app not reinstalling", "manufacturer software missing after reinstall"],
                                             "bloat": 3,
                                             "name":  "Block firmware-injected vendor software (WPBT)",
                                             "desc":  "The Windows Platform Binary Table lets the motherboard firmware drop an executable into Windows and run it at every boot, which is how some vendor software survives a clean install. This switches it off.",
                                             "risk":  1,
                                             "default":  true,
                                             "order":  84,
                                             "reboot":  true,
                                             "actions":  [
                                                             {
                                                                 "type":  "registry",
                                                                 "scope":  "machine",
                                                                 "values":  [
                                                                                {
                                                                                    "path":  "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager",
                                                                                    "name":  "DisableWpbtExecution",
                                                                                    "kind":  "DWord",
                                                                                    "value":  1
                                                                                }
                                                                            ]
                                                             }
                                                         ],
                                             "tier":  3,
                                             "riskNote":  "WPBT is not only used for bloatware. Business laptops ship anti-theft and asset-tracking agents through it, and a few vendors deliver a genuinely required driver this way, so those stop arriving. Nothing already installed is removed - this only stops the firmware putting it back. Reverses cleanly, but needs a restart either way."
                                         },
                                         {
                                             "id":  "device-companion",
                                             "settingsPath": "Undo the run. While the policy is in place, Device Installation Settings in System Properties (sysdm.cpl, Hardware tab) is grayed out.",
                                             "symptoms": ["device app not installing", "no companion app prompt", "hardware app missing"],
                                             "bloat": 2,
                                             "name":  "Stop Windows fetching companion apps for your hardware",
                                             "desc":  "Turns off the device metadata download that fetches a vendor's app when you plug something in. Drivers still install normally. Software a driver package carries with it as a component of its own is not covered - Windows Update can still deliver that.",
                                             "risk":  0,
                                             "default":  true,
                                             "order":  85,
                                             "actions":  [
                                                             {
                                                                 "type":  "registry",
                                                                 "scope":  "machine",
                                                                 "values":  [
                                                                                {
                                                                                    "path":  "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Device Metadata",
                                                                                    "name":  "PreventDeviceMetadataFromNetwork",
                                                                                    "kind":  "DWord",
                                                                                    "value":  1
                                                                                },
                                                                                {
                                                                                    "path":  "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Device Metadata",
                                                                                    "name":  "PreventDeviceMetadataFromNetwork",
                                                                                    "kind":  "DWord",
                                                                                    "value":  1
                                                                                }
                                                                            ]
                                                             }
                                                         ],
                                             "tier":  2
                                         },
                                         {
                                             "id":  "driver-coinstallers",
                                             "settingsPath": "Undo the run.",
                                             "symptoms": ["driver control panel missing", "graphics control panel missing", "no vendor app after driver install", "audio control panel missing"],
                                             "bloat": 3,
                                             "name":  "Block software bundled inside driver packages",
                                             "desc":  "Older driver packages may carry a co-installer that runs vendor software alongside the driver - the route Razer's mouse and keyboard installer used. This stops that half without touching the driver. Newer packages ship their software as a separate component, which this does not affect.",
                                             "risk":  1,
                                             "default":  true,
                                             "order":  85,
                                             "reboot":  true,
                                             "actions":  [
                                                             {
                                                                 "type":  "registry",
                                                                 "scope":  "machine",
                                                                 "values":  [
                                                                                {
                                                                                    "path":  "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Device Installer",
                                                                                    "name":  "DisableCoInstallers",
                                                                                    "kind":  "DWord",
                                                                                    "value":  1
                                                                                }
                                                                            ]
                                                             }
                                                         ],
                                             "tier":  3,
                                             "riskNote":  "A few devices use the co-installer to finish their own setup - some fingerprint readers, docking stations, and audio DSPs among them - and can end up half-configured after a driver update. The driver itself always still installs."
                                         }
                                     ]
                       }
                   ]
}
