                                                                            ],
                                                                 "timeoutSeconds":  900,
                                                                 "match":  [
                                                                               "Lenovo Now*",
                                                                               "Lenovo Welcome*",
                                                                               "Lenovo Migration Assistant*",
                                                                               "Lenovo Smart Appearance*",
                                                                               "Lenovo Voice*",
                                                                               "Lenovo Bundled Software*"
