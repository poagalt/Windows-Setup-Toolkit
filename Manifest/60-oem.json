                                                                 "guards":  [
                                                                                "oem:dell"
                                                                            ],
                                                                 "names":  [
                                                                               "DellInc.DellDigitalDelivery*",
                                                                               "DellInc.DellCustomerConnect*",
                                                                               "DellInc.PartnerPromo*",
                                                                               "DellInc.DellMobileConnect*"
                                                                           ]
                                                             },
                                                             {
                                                                 "type":  "appx",
                                                                 "guards":  [
                                                                                "oem:lenovo"
                                                                            ],
                                                                 "names":  [
                                                                               "*LenovoNow*",
