                                                                                "oem:asus"
                                                                            ],
                                                                 "timeoutSeconds":  900,
                                                                 "match":  [
                                                                               "ASUS GiftBox*",
                                                                               "ASUS Product Register*",
                                                                               "GlideX*"
                                                                           ],
                                                                 "exclude":  [
                                                                                 "Armoury Crate*",
                                                                                 "ASUS System Control Interface*",
                                                                                 "MyASUS Service*"
                                                                             ]
                                                             },
                                                             {
