                                                                 "guards":  [
                                                                                "oem:acer"
                                                                            ],
                                                                 "timeoutSeconds":  900,
                                                                 "match":  [
                                                                               "Acer Care Center*",
                                                                               "Acer Jumpstart*",
                                                                               "Acer Product Registration*",
                                                                               "Acer Collection*",
                                                                               "Planet9*",
                                                                               "Acer ExplorerPro*"
                                                                           ],
                                                                 "exclude":  [
                                                                                 "Acer Quick Access*",
                                                                                 "NitroSense*",
                                                                                 "PredatorSense*"
                                                                             ]
