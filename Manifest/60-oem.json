                                         {
                                             "id":  "oem-support",
                                             "settingsPath": "Reinstall it from your manufacturer support site.",
                                             "symptoms": ["lenovo vantage missing", "hp support assistant missing", "dell support missing", "vendor app gone", "no driver updates", "manufacturer app missing", "support assistant gone"],
                                             "bloat": 3,
                                             "name":  "Vendor support and update suites",
                                             "desc":  "Support Assistant, SupportAssist, Care Center, Samsung Update, and similar.",
                                             "risk":  1,
                                             "default":  true,
                                             "order":  80,
                                             "actions":  [
