                                                                 "guards":  [
                                                                                "oem:asus"
                                                                            ],
                                                                 "names":  [
                                                                               "*ASUSGiftBox*",
                                                                               "*ASUSProductRegistration*"
                                                                           ]
                                                             },
                                                             {
                                                                 "type":  "appx",
                                                                 "guards":  [
