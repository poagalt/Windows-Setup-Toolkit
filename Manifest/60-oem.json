                                                                 "guards":  [
                                                                                "oem:samsung"
                                                                            ],
                                                                 "timeoutSeconds":  900,
                                                                 "match":  [
                                                                               "Samsung Update*",
                                                                               "Samsung Recovery*",
                                                                               "Samsung Studio*",
                                                                               "Samsung PC Cleaner*"
                                                                           ],
                                                                 "exclude":  [
                                                                                 "Samsung Settings*"
                                                                             ]
                                                             },
                                                             {
                                                                 "type":  "uninstall",
                                                                 "guards":  [
                                                                                "oem:msi"
                                                                            ],
                                                                 "timeoutSeconds":  900,
                                                                 "match":  [
                                                                               "MSI App Player*",
                                                                               "MSI Driver*Utility Installer*"
                                                                           ],
                                                                 "exclude":  [
                                                                                 "MSI Center*",
                                                                                 "Dragon Center*"
                                                                             ]
                                                             }
                                                         ],
                                             "tier":  3,
                                             "riskNote":  "Removes the vendor support and update suite. On HP, Dell, and Samsung machines that suite is also how BIOS and driver updates arrive, so afterwards they come from Windows Update or the manufacturer's support site. Firmware, power, and thermal tools are excluded and kept."
                                         },
                                         {
                                             "id":  "oem-companion",
                                             "settingsPath": "Reinstall it from your manufacturer support site.",
                                             "symptoms": ["vendor companion app missing", "oem app gone"],
                                             "bloat": 3,
                                             "name":  "Vendor companion apps",
                                             "desc":  "Lenovo Now, Acer Jumpstart, Dell Customer Connect, HP QuickDrop, and the vendor welcome apps. The vendor's own power, display, and hotkey tools - Lenovo Vantage, MyASUS, MyDell, myHP, and Armoury Crate - are left alone.",
                                             "risk":  0,
                                             "default":  true,
                                             "order":  81,
                                             "actions":  [
                                                             {
                                                                 "type":  "appx",
                                                                 "guards":  [
                                                                                "oem:hp"
                                                                            ],
                                                                 "names":  [
                                                                               "*HPPrivacySettings*",
                                                                               "*HPQuickDrop*",
                                                                               "*HPSystemInformation*",
                                                                               "*HPWorkWell*",
                                                                               "*HPDesktopSupportUtilities*"
                                                                           ]
                                                             },
                                                             {
